# Plantilla. Copia este archivo a deploy.secrets y pon tus credenciales reales:
#   cp deploy.secrets.example deploy.secrets
# deploy.secrets está en .gitignore, así que NO se sube a git.

# De https://my.telegram.org (API development tools):
TELEGRAM_API_ID="12345678"
TELEGRAM_API_HASH="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Token del bot creado con @BotFather:
TELEGRAM_BOT_TOKEN="123456:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Opcional: tu user id de Telegram (si se deja vacío, el primer /start reclama el bot):
TELEGRAM_OWNER_ID=""

# API key de ComicVine (https://comicvine.gamespot.com/api/):
COMICVINE_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Credenciales de Komga (para disparar el re-escaneo de la biblioteca):
KOMGA_EMAIL="user@example.com"
KOMGA_PASSWORD="xxxxxxxx"

# Cuenta de My.JDownloader (https://my.jdownloader.org) — la misma con la que
# está conectado el JDownloader del NAS. El bot añade los links por esta API
# (mismo camino que "Add Links" de la UI); sin esto usa solo crawljobs.
MYJD_EMAIL="user@example.com"
MYJD_PASSWORD="xxxxxxxx"
# Nombre del dispositivo JD tal como aparece en my.jdownloader.org:
MYJD_DEVICE="NAS"
